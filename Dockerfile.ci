# Image CI: binaires musl precompiles (job "build" de
# .github/workflows/ci.yml) + bundle UI + config. Aucune compilation Rust dans
# le conteneur: le build reste rapide, dans les contraintes de timeout des
# jobs. Multi-arch: le binaire correspondant a l'architecture cible est
# selectionne via TARGETARCH (amd64 / arm64).
# (Pour un build local autonome, utiliser le Dockerfile standard.)
FROM alpine:3.20

ARG TARGETARCH
WORKDIR /app

# Certificats CA pour les appels HTTPS (Infomaniak). Le binaire est statique.
RUN apk add --no-cache ca-certificates

# Configuration non-secret; les secrets restent dans l'environnement.
COPY config.toml /app/config.toml

# Bundle UI: infomaniak.js (initializer), infomaniak.css, module wasm (pkg/),
# page de demo.
COPY ui/static /app/ui/static

# Binaire precompile, fourni par la CI dans dist/<arch>/.
COPY dist/${TARGETARCH}/infomaniak-calendar-reservation /usr/local/bin/infomaniak-calendar-reservation

EXPOSE 8080

CMD ["infomaniak-calendar-reservation"]
