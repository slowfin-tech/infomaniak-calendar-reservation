# SAV - Secrets uniquement. Copier ce fichier en .env et renseigner.
# La configuration non-secret (port, CalDAV, creneaux, textes...) vit dans
# config.toml.

# Acces CalDAV au calendar Infomaniak
CALDAV_LOGIN=
CALDAV_PASSWORD=

# Token Bearer pour l'API Infomaniak (scopes kmeet + workspace:calendar)
KMEET_API_TOKEN=

# Cle d'API exigee par tous les endpoints du serveur
# (Authorization: Bearer <cle>) et embarquee dans le module wasm au build.
# Generer par ex: openssl rand -hex 32
SAV_API_KEY=

# SMTP pour l'email de confirmation (STARTTLS sur 587, TLS implicite sur 465)
SMTP_USER=
SMTP_PASSWORD=
SMTP_SEND_URL=
SMTP_SEND_PORT=587

# Optionnel - module wasm:
# SAV_URL=http://localhost:8080   (vide = meme origine que la page)
