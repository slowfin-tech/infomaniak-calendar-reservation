# SAV Appointment Server - Configuration

# URL de base CalDAV pour Infomaniak
# Obligatoire pour la synchronisation des événements
CALDAV_URL=https://sync.infomaniak.com/

# URI du calendrier CalDAV (relatif à CALDAV_URL)
# Exemple: /calendars/ND04237/f28b6a18-5cdd-410b-9cc4-ae95932ff536/
# Optionnel : si non fourni, essayé de construire depuis KCALENDAR_URL ou utilise un calendrier par défaut
CALDAV_CALENDAR_URI=/calendars/your_user_id/your_calendar_id/

# Identifiant pour l'authentification CalDAV (sans le domaine)
# Exemple: ND04237
# Obligatoire pour la synchronisation CalDAV
CALDAV_LOGIN=your_username_here

# Mot de passe pour l'authentification CalDAV
# Obligatoire pour la synchronisation CalDAV
CALDAV_PASSWORD=your_password_here

# URL du calendrier Infomaniak (kcalendar) - Optionnel pour la compatibilité descendante
# Peut être utilisé pour construire CALDAV_CALENDAR_URI automatiquement
KCALENDAR_URL=https://sync.infomaniak.com/calendars/your_user_id/your_calendar_id?export

# URL de base pour les liens visio (kmeet)
# Optionnel : par défaut = https://meet.kmeet.infomaniak.com/sav
VISIO_BASE_URL=https://meet.kmeet.infomaniak.com/sav

# Token API pour Infomaniak KMeet (nécessaire pour créer des salles)
# Obligatoire pour l'intégration KMeet
KMEET_API_TOKEN=your_kmeet_api_token_here

# ID du calendrier (optionnel, utilisé pour certaines intégrations)
KCALENDAR_ID=your_calendar_id_here
