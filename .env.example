# infomaniak-calendar-reservation - Secrets uniquement. Copier ce fichier en
# .env et renseigner. La configuration non-secret (port, CalDAV, creneaux,
# textes...) vit dans config.toml.

# Acces CalDAV au calendar Infomaniak
CALDAV_LOGIN=
CALDAV_PASSWORD=

# Token Bearer pour l'API Infomaniak (scopes kmeet + workspace:calendar)
KMEET_API_TOKEN=

# Cle d'API exigee par tous les endpoints du serveur
# (Authorization: Bearer <cle>), servie au module wasm via GET /api/config.
# Generer par ex: openssl rand -hex 32
# (SAV_API_KEY reste accepte en repli, avant renommage du projet)
INFOMANIAK_API_KEY=

# SMTP pour l'email de confirmation (STARTTLS sur 587, TLS implicite sur 465)
SMTP_USER=
SMTP_PASSWORD=
SMTP_SEND_URL=
SMTP_SEND_PORT=587
